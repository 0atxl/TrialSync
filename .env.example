# Local development values only. Replace the password before shared use.
POSTGRES_DB=trialsync
POSTGRES_USER=trialsync
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://trialsync:replace-with-local-password@localhost:5432/trialsync

TRIALSYNC_ENVIRONMENT=development
TRIALSYNC_DEBUG=false
TRIALSYNC_AUTH_SECRET=replace-with-a-random-string-at-least-32-characters
TRIALSYNC_ACCESS_TOKEN_MINUTES=480
TRIALSYNC_CORS_ORIGINS=["http://localhost:5173"]

VITE_API_BASE_URL=http://localhost:8000/api/v1
