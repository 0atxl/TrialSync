# Copy to .env.production and replace every CHANGE_ME value before deploying.
# The database host is the Compose service DNS name, not localhost.
POSTGRES_DB=trialsync
POSTGRES_USER=trialsync
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32
DATABASE_URL=postgresql+psycopg://trialsync:CHANGE_ME_urlencode_the_postgres_password@db:5432/trialsync

TRIALSYNC_ENVIRONMENT=production
TRIALSYNC_DEBUG=false
# Generate with: openssl rand -hex 48
TRIALSYNC_AUTH_SECRET=CHANGE_ME_generate_a_unique_96_character_random_secret
TRIALSYNC_ACCESS_TOKEN_MINUTES=480
TRIALSYNC_CORS_ORIGINS=["https://trialsync.atuls.me"]

# Leave empty to use the deterministic/canonical fallbacks, or set a Groq key at deployment time.
GROQ_API_KEY=
TRIALSYNC_GROQ_MODEL=openai/gpt-oss-20b
TRIALSYNC_EXTRACTION_PROVIDER=groq
TRIALSYNC_SCREENING_CHAT_PROVIDER=auto
TRIALSYNC_PROVIDER_TIMEOUT_SECONDS=12
TRIALSYNC_PROVIDER_MAX_RETRIES=1
TRIALSYNC_PROVIDER_MAX_INPUT_CHARS=100000
TRIALSYNC_SCREENING_CHAT_MESSAGE_MAX_CHARS=1000
TRIALSYNC_SCREENING_CHAT_MAX_MESSAGES=10
TRIALSYNC_SCREENING_CHAT_MAX_ANSWER_CHARS=2000
