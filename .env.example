# Local development values only. Replace the password before shared use.
POSTGRES_DB=trialsync
POSTGRES_USER=trialsync
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://trialsync:replace-with-local-password@localhost:5432/trialsync

TRIALSYNC_ENVIRONMENT=development
TRIALSYNC_DEBUG=false
TRIALSYNC_AUTH_SECRET=replace-with-a-random-string-at-least-32-characters
TRIALSYNC_ACCESS_TOKEN_MINUTES=480
TRIALSYNC_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
GROQ_API_KEY=
TRIALSYNC_GROQ_MODEL=openai/gpt-oss-20b
TRIALSYNC_EXTRACTION_PROVIDER=groq
TRIALSYNC_SCREENING_CHAT_PROVIDER=auto
TRIALSYNC_PROVIDER_TIMEOUT_SECONDS=12
TRIALSYNC_PROVIDER_MAX_RETRIES=1
TRIALSYNC_PROVIDER_MAX_INPUT_CHARS=100000
TRIALSYNC_SCREENING_CHAT_MESSAGE_MAX_CHARS=1000
TRIALSYNC_SCREENING_CHAT_MAX_MESSAGES=10
TRIALSYNC_SCREENING_CHAT_MAX_ANSWER_CHARS=2000
TRIALSYNC_TERMINOLOGY_SUGGESTIONS_ENABLED=true
TRIALSYNC_TERMINOLOGY_TIMEOUT_SECONDS=5
TRIALSYNC_TERMINOLOGY_MAX_RESULTS=5
# Optional: LOINC lookup requires a free LOINC account and Basic Auth credentials.
TRIALSYNC_LOINC_USERNAME=
TRIALSYNC_LOINC_PASSWORD=

VITE_API_BASE_URL=http://localhost:8000/api/v1
